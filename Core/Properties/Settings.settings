    <Setting Name="InputLogCore_be_ugent_lt3serv_PreProWS" Type="(Web Service URL)" Scope="Application">
      <Value Profile="(Default)">https://lt3serv.ugent.be:80/PreProService/PreProWS</Value>
    </Setting>
  </Settings>
</SettingsFile>