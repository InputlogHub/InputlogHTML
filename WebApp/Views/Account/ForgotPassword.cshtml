@model WebApp.Models.ResetPasswordModel

@{
    ViewBag.Title = "Forgot Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Forgot Password</h2>
<p class="warning">Enter your username or email and click the button to reset your password. 
    Your password will be reset and a new password will be e-mailed.</p>
@using (Html.BeginForm("ResetPassword", "Account"))
{
    @Html.ValidationSummary(true, "Password reset was unsuccessful. Please correct the errors and try again.")
    <div>
        <fieldset>
            <legend>Reset Password</legend>
            <div class="editor-label">
                @Html.LabelFor(m => m.UserName)
            </div>
            <div class="editor-field">
                @Html.TextBoxFor(m => m.UserName)
                @Html.ValidationMessageFor(m => m.UserName)
            </div>
                
            <div class="editor-label">
                @Html.LabelFor(m => m.Email)
            </div>
            <div class="editor-field">
                @Html.TextBoxFor(m => m.Email)
                @Html.ValidationMessageFor(m => m.Email)
            </div>
        </fieldset>
        <p>
            <input type="submit" value="Reset" />
        </p>  
    </div>
}

