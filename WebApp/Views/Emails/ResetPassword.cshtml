@{ Layout = null; /* Overrides the Layout set for regular page views. */ }
To: @ViewBag.To
From: Inputlog <inputlog@uantwerpen.be/>
Subject: Inputlog password reset
<html>
<head></head>
<body>
    <table style="width:775px;background-color:#e5e5e5;">
        <tr style="height:11px;width:100%;">
        </tr>
        <tr style="height:11px;width:100%;">
            <td style="width:90px;"></td>
            <td style="background-color:#fff; padding:16px 20px">
                <img src="https://www.inputlog.net/images/Home_picture.gif" alt="Inputlog header" />
                <p style="text-align:center; padding:8px 20px; font-size:10.5pt; line-height:125%; 
                font-family:'Calibri','sans-serif'; color:#17375e;">
                    Dear @ViewBag.Username,<br />
                    <b>New password:</b> <br />
                    @ViewBag.NewPass
                </p>
            </td>
            <td style="width:90px;"></td>
        </tr>
        <tr style="height:11px;width:100%;">
        </tr>
    </table>
</body>
</html>