\ProvidesPackage{ua}
\usepackage{wallpaper}

\renewcommand{\date}[1]{\renewcommand\@date{#1}}
\renewcommand{\author}[1]{\renewcommand\@author{#1}}
\renewcommand{\title}[1]{\renewcommand\@title{#1}}
\newcommand{\assignment}[1]{\newcommand\@assignment{#1}}
\newcommand{\course}[1]{\newcommand\@course{#1}}
\newcommand{\subtitle}[1]{\newcommand\@subtitle{#1}}
\newcommand{\authors}[1]{\newcommand\@authors{#1}}

\newcommand{\clap}[1]{\makebox[\textwidth]{#1}}
\newcommand{\lowr}[1]{
  \hbox to \hsize{
    \llap{\vbox{\raggedleft #1}}}}
\newcommand{\aline}[1]{\vbox{\centering #1}}

\newcommand{\maketitledoc}{
  \begin{titlepage}
  \thispagestyle{empty}\vbox to \vsize{
		\ThisLRCornerWallPaper{1}{latex_img/uabottomwave.pdf}
		\ThisURCornerWallPaper{0.2}{latex_img/logo_UA_U_kl3.pdf}
		\ThisLLCornerWallPaper{0.3}{latex_img/logo_UA_tekst_kl.pdf}
    \vfill
    \aline{\Large \@title}
    \vspace{7mm}
    \aline{\large \@author}
    \vspace{5mm}
    \aline{\@date}
    \vspace{10mm}
	\vfill
    \vfill
    \vfill
  }
  \cleardoublepage
  \end{titlepage}
}

