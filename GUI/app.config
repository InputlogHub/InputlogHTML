<?xml version="1.0" encoding="utf-8"?>
<!--GUI CONFIG-->
<configuration>
  <configSections>
    <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="GUI.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
      <section name="GUI.Properties.Options" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
    </sectionGroup>
    <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="GUI.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
    </sectionGroup>
  </configSections>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <userSettings>
    <GUI.Properties.Settings>
      <setting name="Workspace" serializeAs="String">
        <value />
      </setting>
      <setting name="SeperateMouseMovements" serializeAs="String">
        <value>True</value>
      </setting>
      <setting name="MouseMovementPauseThreshold" serializeAs="String">
        <value>1000</value>
      </setting>
      <setting name="Record_OpenWith" serializeAs="String">
        <value>notepad</value>
      </setting>
      <setting name="Record_AnalysisDoneChoice" serializeAs="String">
        <value>0</value>
      </setting>
      <setting name="GroupedKeysList" serializeAs="Xml">
        <value>
          <ArrayOfString xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="https://www.w3.org/2001/XMLSchema">
            <string>VK_LSHIFT</string>
            <string>VK_RSHIFT</string>
            <string>VK_LCONTROL</string>
            <string>VK_RCONTROL</string>
            <string>VK_SHIFT</string>
            <string>VK_CONTROL</string>
            <string>VK_LMENU</string>
            <string>VK_MENU</string>
            <string>VK_LEFT</string>
            <string>VK_RIGHT</string>
            <string>VK_UP</string>
            <string>VK_DOWN</string>
            <string>VK_HOME</string>
            <string>VK_END</string>
            <string>VK_PAUSE</string>
            <string>VK_ESCAPE</string>
            <string>VK_PRINT</string>
            <string>VK_NUMLOCK</string>
            <string>VK_SCROLL</string>
          </ArrayOfString>
        </value>
      </setting>
      <setting name="AutoHide" serializeAs="String">
        <value>True</value>
      </setting>
      <setting name="Analysis_RecognizeDoubleClicks" serializeAs="String">
        <value>False</value>
      </setting>
      <setting name="Analysis_DoubleClickThreshold" serializeAs="String">
        <value>-1</value>
      </setting>
      <setting name="PlayBarValue" serializeAs="String">
        <value>50</value>
      </setting>
      <setting name="Analysis_DestinationSubdirectory" serializeAs="String">
        <value>output</value>
      </setting>
      <setting name="StorePersonalMaxima" serializeAs="String">
        <value>True</value>
      </setting>
      <setting name="Record_EventSelection" serializeAs="String">
        <value>0,1,2</value>
      </setting>
      <setting name="Record_PluginSelection" serializeAs="String">
        <value>0,1</value>
      </setting>
      <setting name="Record_LogFormat" serializeAs="String">
        <value>0</value>
      </setting>
      <setting name="HighPrecision" serializeAs="String">
        <value>True</value>
      </setting>
      <setting name="StorePersonalOptima" serializeAs="String">
        <value>True</value>
      </setting>
    </GUI.Properties.Settings>
    <GUI.Properties.Options>
      <setting name="WorkspaceDir" serializeAs="String">
        <value />
      </setting>
      <setting name="WLOverride" serializeAs="String">
        <value>True</value>
      </setting>
    </GUI.Properties.Options>
  </userSettings>
  <applicationSettings>
    <GUI.Properties.Settings>
      <setting name="BalloonTipTimeOut" serializeAs="String">
        <value>10000</value>
      </setting>
      <setting name="SessionStateFileName" serializeAs="String">
        <value>sessionstate</value>
      </setting>
      <setting name="PlayIntervalMin" serializeAs="String">
        <value>5</value>
      </setting>
      <setting name="PlayIntervalMax" serializeAs="String">
        <value>500</value>
      </setting>
      <setting name="Logfile_extension" serializeAs="String">
        <value>idfx</value>
      </setting>
      <setting name="Original_doc_appendix" serializeAs="String">
        <value>_original</value>
      </setting>
      <setting name="DefaultGroupedKeysList" serializeAs="Xml">
        <value>
          <ArrayOfString xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="https://www.w3.org/2001/XMLSchema">
            <string>VK_LSHIFT</string>
            <string>VK_RSHIFT</string>
            <string>VK_LCONTROL</string>
            <string>VK_RCONTROL</string>
            <string>VK_SHIFT</string>
            <string>VK_CONTROL</string>
            <string>VK_LMENU</string>
            <string>VK_MENU</string>
            <string>VK_LEFT</string>
            <string>VK_RIGHT</string>
            <string>VK_UP</string>
            <string>VK_DOWN</string>
            <string>VK_HOME</string>
            <string>VK_END</string>
            <string>VK_PAUSE</string>
            <string>VK_ESCAPE</string>
            <string>VK_PRINT</string>
            <string>VK_NUMLOCK</string>
            <string>VK_SCROLL</string>
          </ArrayOfString>
        </value>
      </setting>
    </GUI.Properties.Settings>
  </applicationSettings>
  <appSettings> 

    <!-- LOCAL 
    <add key="InputLogServer" value="http://localhost:18477/" />
    -->
    <!-- UA SERVER  -->
    <add key="InputLogServer" value="https://inputlog.uantwerpen.be/WebSite/" /> 
    <add key="InputlogDownloadURL" value="https://www.inputlog.net/download_software.html" />
    <add key="InputlogHelpURL" value="https://www.inputlog.net/faq/" />
