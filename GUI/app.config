    <add key="MoreInfo_RM" value="https://www.inputlog.net/wp-content/uploads/Inputlog_manual.pdf#page=88" />
    <add key="MoreInfo_WP" value="https://www.inputlog.net/wp-content/uploads/Inputlog_manual.pdf" />
    <add key="MoreInfo_time" value="https://www.inputlog.net/wp-content/uploads/Inputlog_manual.pdf#page=37" />
    <add key="MoreInfo_event" value="https://www.inputlog.net/wp-content/uploads/Inputlog_manual.pdf#page=39" />
    <add key="MoreInfo_window" value="https://www.inputlog.net/wp-content/uploads/Inputlog_manual.pdf#page=40" />
