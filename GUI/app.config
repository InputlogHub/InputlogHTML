    <add key="InputlogCopyTaskManual" value="https://www.inputlog.net/wp-content/uploads/Copy-task-construction_manual.pdf" />
    <add key="InputlogCopyTaskVariables" value="https://www.inputlog.net/overview-variable-names-in-copy-task-analysis-after-merge_update-may-2020/" />
    <add key="InputlogReportVariables" value="https://www.inputlog.net/wp-content/uploads/ReportingLabelsFull_March_2018.pdf" />
    <add key="MoreInfo_CT" value="https://www.inputlog.net/wp-content/uploads/Copy-task-construction_manual.pdf" />
    <add key="MoreInfo_LA" value="https://www.inputlog.net/wp-content/uploads/Inputlog_manual.pdf#page=73" />
    <add key="MoreInfo_TA" value="https://www.inputlog.net/wp-content/uploads/Inputlog_manual.pdf#page=108" />
